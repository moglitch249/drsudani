# منع تصفح المجلدات
Options -Indexes

# منع تنفيذ سكربتات PHP أو أي لغة برمجية أخرى داخل هذا المجلد بالكامل
<FilesMatch "\.(php|php4|php5|php7|php8|phtml|pl|py|jsp|asp|htm|html|shtml|sh|cgi)$">
    Deny from all
</FilesMatch>

# السماح للصور فقط بالعمل (اختياري لزيادة الأمان)
<FilesMatch "\.(jpeg|jpg|png|gif|webp)$">
    Allow from all
</FilesMatch>

# منع الوصول لملف .htaccess نفسه
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>
